version: "3.9"
services:
  web:
    build: .
    ports:
      - "3000:3000"
    environment:
      - NODE_ENV=development
      - WATCHPACK_POLLING=true
      - CHOKIDAR_USEPOLLING=true
      - DATABASE_URL=postgresql://user:pass@db:5432/salon_os
      - DIRECT_URL=postgresql://user:pass@db:5432/salon_os
    volumes:
      - .:/app
      - /app/node_modules
    command: npm run dev
    depends_on:
      - db
  db:
    image: postgres:15-alpine
    ports:
      - "5432:5432"
    environment:
      POSTGRES_USER: user
      POSTGRES_PASSWORD: pass
      POSTGRES_DB: salon_os
    volumes:
      - postgres_data:/var/lib/postgresql/data

volumes:
  postgres_data:
